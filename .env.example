# =============================================================================
#  Smart Public Transportation Route Optimization — Environment Configuration
#  Copy this file to .env and configure values before starting the application.
# =============================================================================

# ── Backend Configuration ───────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ── Database Connection (MySQL / TiDB Cloud Serverless) ──────────────────────
# You may specify either a complete DATABASE_URL or the individual components.
DATABASE_URL=jdbc:mysql://localhost:3306/smart_transport_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_transport_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── Cross-Origin Resource Sharing (CORS) ────────────────────────────────────
# Comma-separated list of allowed frontend origins in production
FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend-app.vercel.app

# ── Frontend Configuration ──────────────────────────────────────────────────
# Leave blank for local development (uses Vite /api proxy); set to backend URL in production.
VITE_API_BASE_URL=https://your-backend-app.onrender.com
