# =============================================================================
#  Root .gitignore for Smart Public Transportation Route Optimization
# =============================================================================

# ── Environment & Secret Protection ──────────────────────────────────────────
.env
.env.*
*.env
*.local
!.env.example
!**/.env.example

# ── Backend / Java Artifacts ─────────────────────────────────────────────────
**/target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ── Frontend / Node Artifacts ────────────────────────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.oxlint-cache/

# ── IDEs & Operating System Artifacts ────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
.DS_Store
Thumbs.db
desktop.ini
